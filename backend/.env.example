APP_ENV=development
APP_DEBUG=true
APP_URL=http://127.0.0.1:8123
PASSWORD_RESET_URL=http://127.0.0.1:8080/#/reset-password
APP_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
GOOGLE_OAUTH_WEB_CLIENT_ID=

# Configure a real mail provider before enabling registration in production.
MAIL_FROM=your-gmail-address@gmail.com
MAIL_FROM_NAME=URL Defender
MAIL_TRANSPORT=log
RESEND_API_KEY=
# Gmail SMTP: create a Google App Password after enabling 2-Step Verification.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=
SMTP_ENCRYPTION=ssl

# Never expose provider secrets to Flutter.
VIRUSTOTAL_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=change_me
TEAM_PRICE_PAISE=9900
ENTERPRISE_PRICE_PAISE=49900
